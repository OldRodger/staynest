{
  "extends": "@tsconfig/node23/tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    // REMOVE BELOW BEFORE BUILD
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
